{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apex-forensics.dev/v1/ai-enrichment.schema.json",
  "title": "APEX Provider-neutral AI Enrichment Boundary",
  "oneOf": [
    { "$ref": "#/$defs/enrichmentRequest" },
    { "$ref": "#/$defs/enrichmentResult" }
  ],
  "$defs": {
    "enrichmentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "analysis_context", "purpose", "output_locale", "requested_at"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/uuid" },
        "analysis_context": {
          "$ref": "analysis-context.schema.json#/$defs/analysisContext"
        },
        "purpose": {
          "enum": [
            "SUMMARIZE",
            "EXPLAIN_ARTIFACT",
            "CORRELATE",
            "ASSESS_RISK",
            "SUMMARIZE_TIMELINE",
            "RECOMMEND_NEXT_ANALYSIS",
            "DRAFT_REPORT"
          ]
        },
        "output_locale": { "$ref": "common.schema.json#/$defs/locale" },
        "requested_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "observedFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "source_confidence", "citations"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/uuid" },
        "statement": { "type": "string", "minLength": 1 },
        "source_confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "citation.schema.json#/$defs/citation" }
        }
      }
    },
    "analystAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotation_id", "text", "citations"],
      "properties": {
        "annotation_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "text": { "type": "string", "minLength": 1 },
        "citations": {
          "type": "array",
          "items": { "$ref": "citation.schema.json#/$defs/citation" }
        }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "confidence", "citations", "limitations"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/uuid" },
        "statement": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "citation.schema.json#/$defs/citation" }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "priority", "rationale", "citations"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/uuid" },
        "action": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "rationale": { "type": "string", "minLength": 1 },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "citation.schema.json#/$defs/citation" }
        }
      }
    },
    "enrichmentResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "request_id",
        "analysis_context_id",
        "status",
        "locale",
        "summary",
        "observed_facts",
        "analyst_annotations",
        "inferences",
        "recommendations",
        "citations",
        "confidence",
        "limitations",
        "adapter_ref",
        "created_at",
        "completed_at",
        "errors"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/uuid" },
        "request_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "analysis_context_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "status": { "enum": ["PENDING", "SUCCEEDED", "FAILED"] },
        "locale": { "$ref": "common.schema.json#/$defs/locale" },
        "summary": { "type": ["string", "null"] },
        "observed_facts": {
          "type": "array",
          "items": { "$ref": "#/$defs/observedFact" }
        },
        "analyst_annotations": {
          "type": "array",
          "items": { "$ref": "#/$defs/analystAnnotation" }
        },
        "inferences": {
          "type": "array",
          "items": { "$ref": "#/$defs/inference" }
        },
        "recommendations": {
          "type": "array",
          "items": { "$ref": "#/$defs/recommendation" }
        },
        "citations": {
          "type": "array",
          "items": { "$ref": "citation.schema.json#/$defs/citation" }
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "adapter_ref": { "type": ["string", "null"] },
        "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "completed_at": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/timestamp" },
            { "type": "null" }
          ]
        },
        "errors": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/error" }
        }
      }
    }
  }
}
