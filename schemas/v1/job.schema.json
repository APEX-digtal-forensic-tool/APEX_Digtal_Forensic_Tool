{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apex-forensics.dev/v1/job.schema.json",
  "title": "APEX Job",
  "$ref": "#/$defs/job",
  "$defs": {
    "nullableTimestamp": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "total",
        "unit",
        "processed_items",
        "estimated_total_items",
        "progress_percent",
        "throughput_items_per_second",
        "elapsed_seconds",
        "estimated_remaining_seconds",
        "estimate_confidence",
        "current_analyzer",
        "worker_count",
        "cache_hits",
        "cache_misses",
        "partial_results_available",
        "status"
      ],
      "properties": {
        "current": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "enum": [
            "BYTES",
            "FILES",
            "TASKS",
            "UNKNOWN"
          ]
        },
        "percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100,
          "deprecated": true,
          "description": "Legacy compatibility alias. New contracts use progress_percent."
        },
        "processed_items": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_total_items": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "throughput_items_per_second": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "estimated_remaining_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "estimate_confidence": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "UNKNOWN"
          ]
        },
        "current_analyzer": {
          "type": [
            "string",
            "null"
          ]
        },
        "worker_count": {
          "type": "integer",
          "minimum": 0
        },
        "cache_hits": {
          "type": "integer",
          "minimum": 0
        },
        "cache_misses": {
          "type": "integer",
          "minimum": 0
        },
        "partial_results_available": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "QUEUED",
            "RUNNING",
            "PAUSING",
            "PAUSED",
            "RESUMING",
            "SUCCEEDED",
            "PARTIAL",
            "FAILED",
            "CANCELLED"
          ]
        },
        "progress_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100,
          "description": "Estimated completion percentage; null when the total cannot be estimated."
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "case_id",
        "evidence_id",
        "job_type",
        "status",
        "progress",
        "queued_at",
        "started_at",
        "finished_at",
        "cancel_requested_at",
        "warnings",
        "errors",
        "profile_id",
        "priority",
        "checkpoint_available",
        "result_completeness"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "case_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "evidence_id": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "job_type": {
          "enum": [
            "HASH",
            "FS_INGEST",
            "ARTIFACT",
            "TIMELINE",
            "INDEX",
            "SEARCH",
            "AI_ENRICHMENT",
            "REPORT_DRAFT",
            "REPORT_EXPORT",
            "MEDIA_EXTRACTION",
            "TIMEZONE_DETECTION",
            "CUSTODY_SNAPSHOT",
            "KEYWORD_RECOMMENDATION"
          ]
        },
        "status": {
          "enum": [
            "QUEUED",
            "RUNNING",
            "PAUSING",
            "PAUSED",
            "RESUMING",
            "SUCCEEDED",
            "PARTIAL",
            "FAILED",
            "CANCELLED"
          ]
        },
        "progress": {
          "$ref": "#/$defs/progress"
        },
        "queued_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "started_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "finished_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "cancel_requested_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/warning"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/error"
          }
        },
        "profile_id": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "checkpoint_available": {
          "type": "boolean"
        },
        "result_completeness": {
          "$ref": "common.schema.json#/$defs/partialResult"
        }
      }
    }
  }
}
