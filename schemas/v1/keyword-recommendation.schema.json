{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apex-forensics.dev/v1/keyword-recommendation.schema.json",
  "title": "APEX Keyword Recommendation and Keyword Set",
  "oneOf": [
    {
      "$ref": "#/$defs/keywordCandidate"
    },
    {
      "$ref": "#/$defs/keywordSet"
    },
    {
      "$ref": "#/$defs/keywordApproval"
    }
  ],
  "$defs": {
    "keywordType": {
      "enum": [
        "FILE_NAME",
        "PROCESS_NAME",
        "ACCOUNT",
        "EMAIL",
        "DOMAIN",
        "URL",
        "IP_ADDRESS",
        "REGISTRY_PATH",
        "COMMAND",
        "PATH",
        "DOCUMENT_TERM",
        "HASH",
        "REGEX",
        "RELATED_TERM",
        "TRANSLITERATION",
        "TYPO_VARIANT"
      ]
    },
    "keywordCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "case_id",
        "analysis_context_id",
        "context_scope",
        "context_revision",
        "keyword",
        "type",
        "reason",
        "scope",
        "citations",
        "confidence",
        "source_kind",
        "status",
        "variants",
        "partial_result",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "case_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "analysis_context_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "context_scope": {
          "$ref": "common.schema.json#/$defs/analysisScope"
        },
        "context_revision": {
          "type": "integer",
          "minimum": 1
        },
        "keyword": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "type": {
          "$ref": "#/$defs/keywordType"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/analysisScope"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "citation.schema.json#/$defs/citation"
          }
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "source_kind": {
          "enum": [
            "AI_RECOMMENDATION",
            "ANALYST"
          ]
        },
        "status": {
          "enum": [
            "PENDING_REVIEW",
            "APPROVED",
            "REJECTED"
          ]
        },
        "variants": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "partial_result": {
          "type": "boolean"
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "AI_RECOMMENDATION"
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "properties": {
              "citations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "citation.schema.json#/$defs/citation"
                }
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      ]
    },
    "keywordSetItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "candidate_id",
        "keyword",
        "type",
        "source_kind",
        "approved"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "candidate_id": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "keyword": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/keywordType"
        },
        "source_kind": {
          "enum": [
            "AI_RECOMMENDATION",
            "ANALYST"
          ]
        },
        "approved": {
          "type": "boolean"
        }
      }
    },
    "keywordSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "case_id",
        "name",
        "version",
        "status",
        "items",
        "created_by",
        "created_at",
        "content_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "case_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "DRAFT",
            "APPROVED",
            "EXECUTED",
            "SUPERSEDED"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/keywordSetItem"
          }
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "content_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "keywordApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "case_id",
        "recommendation_id",
        "decision",
        "reason",
        "decided_by",
        "decided_at"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "case_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "recommendation_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "decision": {
          "enum": [
            "APPROVED",
            "REJECTED"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "decided_by": {
          "type": "string",
          "minLength": 1
        },
        "decided_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    }
  }
}
