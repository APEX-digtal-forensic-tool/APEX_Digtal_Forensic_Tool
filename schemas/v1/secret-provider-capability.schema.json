{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apex-forensics.dev/v1/secret-provider-capability.schema.json",
  "title": "APEX Secret Provider Capability",
  "$ref": "#/$defs/secretProviderCapability",
  "$defs": {
    "warning": {
      "type": "object",
      "additionalProperties": true,
      "allOf": [{ "$ref": "common.schema.json#/$defs/redactedObject" }],
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
      }
    },
    "secretProviderCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "provider_id",
        "provider_version",
        "capability_type",
        "runtime_status",
        "supported_key_sources",
        "supported_algorithms",
        "requires_host",
        "requires_network",
        "warnings",
        "generated_at"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "provider_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "provider_version": { "type": "string", "minLength": 1, "maxLength": 256 },
        "capability_type": {
          "enum": [
            "SECRET_PROVIDER",
            "DPAPI_PROVIDER",
            "NSS_PROVIDER",
            "KAKAOTALK_PROVIDER"
          ]
        },
        "runtime_status": {
          "enum": [
            "AVAILABLE",
            "AVAILABLE_WITH_EXTERNAL_KEY",
            "IMPLEMENTED_RUNTIME",
            "PARTIAL",
            "CAPABILITY_UNAVAILABLE",
            "KEY_UNAVAILABLE",
            "UNSUPPORTED",
            "UNSUPPORTED_VERSION"
          ]
        },
        "supported_key_sources": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "supported_algorithms": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "requires_host": { "type": "boolean" },
        "requires_network": { "type": "boolean" },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/warning" }
        },
        "generated_at": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/timestamp" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
