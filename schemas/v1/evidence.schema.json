{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apex-forensics.dev/v1/evidence.schema.json",
  "title": "APEX Evidence",
  "$ref": "#/$defs/evidence",
  "$defs": {
    "hash": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "algorithm": { "const": "SHA256" } },
            "required": ["algorithm"]
          },
          "then": {
            "properties": {
              "digest_hex": { "$ref": "common.schema.json#/$defs/sha256" }
            }
          }
        },
        {
          "if": {
            "properties": { "algorithm": { "const": "MD5" } },
            "required": ["algorithm"]
          },
          "then": {
            "properties": {
              "digest_hex": { "$ref": "common.schema.json#/$defs/md5" }
            }
          }
        },
        {
          "if": {
            "properties": { "algorithm": { "const": "SHA512" } },
            "required": ["algorithm"]
          },
          "then": {
            "properties": {
              "digest_hex": {
                "type": "string",
                "pattern": "^[0-9a-f]{128}$"
              }
            }
          }
        }
      ],
      "required": [
        "algorithm",
        "digest_hex",
        "scope",
        "bytes_hashed",
        "completed_at",
        "verification_status"
      ],
      "properties": {
        "algorithm": {
          "enum": ["SHA256", "MD5", "SHA512"]
        },
        "digest_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]+$"
        },
        "scope": {
          "enum": ["FULL_SOURCE", "LOGICAL_STREAM"]
        },
        "bytes_hashed": {
          "type": "integer",
          "minimum": 0
        },
        "completed_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "verification_status": {
          "enum": ["NOT_CHECKED", "MATCH", "MISMATCH"]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "case_id",
        "display_name",
        "format",
        "status",
        "size_bytes",
        "read_only",
        "registered_at",
        "reader",
        "capabilities",
        "hashes",
        "metadata"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "case_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": ["DIRECTORY", "RAW", "E01", "VHD", "VHDX"]
        },
        "status": {
          "enum": ["REGISTERED", "HASHING", "READY", "FAILED"]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sector_size": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "read_only": {
          "const": true
        },
        "acquired_at": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/timestamp" },
            { "type": "null" }
          ]
        },
        "registered_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "reader": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "hashes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hash"
          }
        },
        "metadata": {
          "$ref": "common.schema.json#/$defs/metadata"
        }
      }
    }
  }
}
