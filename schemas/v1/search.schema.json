{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apex-forensics.dev/v1/search.schema.json",
  "title": "APEX Search",
  "oneOf": [
    { "$ref": "#/$defs/searchQuery" },
    { "$ref": "#/$defs/searchResult" }
  ],
  "$defs": {
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_ids", "artifact_types", "time_from", "time_to"],
      "properties": {
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/uuid" }
        },
        "artifact_types": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "time_from": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/timestamp" },
            { "type": "null" }
          ]
        },
        "time_to": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/timestamp" },
            { "type": "null" }
          ]
        }
      }
    },
    "searchQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "query", "scope", "filters", "cursor", "limit"],
      "properties": {
        "mode": { "enum": ["KEYWORD", "EXACT", "REGEX"] },
        "query": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["FILE", "ARTIFACT", "TIMELINE"] }
        },
        "filters": { "$ref": "#/$defs/filters" },
        "cursor": { "type": ["string", "null"] },
        "limit": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "searchHit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidence_id",
        "source_kind",
        "source_id",
        "title",
        "path",
        "snippet",
        "score",
        "matched_fields"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/uuid" },
        "evidence_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "source_kind": { "enum": ["FILE", "ARTIFACT", "TIMELINE"] },
        "source_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "title": { "type": "string", "minLength": 1 },
        "path": { "type": ["string", "null"] },
        "snippet": { "type": ["string", "null"] },
        "score": { "type": "number", "minimum": 0 },
        "matched_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "searchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_id", "took_ms", "hits", "page", "warnings"],
      "properties": {
        "query_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "took_ms": { "type": "integer", "minimum": 0 },
        "hits": {
          "type": "array",
          "items": { "$ref": "#/$defs/searchHit" }
        },
        "page": { "$ref": "common.schema.json#/$defs/pageInfo" },
        "warnings": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/warning" }
        }
      }
    }
  }
}
