{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apex-forensics.dev/v1/ai-provider-capability.schema.json",
  "title": "APEX AI Provider Capability",
  "$ref": "#/$defs/aiProviderCapability",
  "$defs": {
    "operation": {
      "enum": [
        "RECOMMEND_KEYWORDS",
        "SUMMARIZE_SCOPE",
        "EXPLAIN_SELECTION",
        "SUGGEST_NEXT_ANALYSIS",
        "OTHER"
      ]
    },
    "warning": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
      }
    },
    "aiProviderCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "provider_id",
        "provider_version",
        "supported_operations",
        "max_request_items",
        "max_result_items",
        "max_summary_length",
        "is_available",
        "unavailable_reason",
        "warnings",
        "generated_at"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "provider_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "provider_version": { "type": "string", "minLength": 1, "maxLength": 256 },
        "supported_operations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/operation" }
        },
        "max_request_items": { "type": "integer", "minimum": 0 },
        "max_result_items": { "type": "integer", "minimum": 0 },
        "max_summary_length": { "type": "integer", "minimum": 0 },
        "is_available": { "type": "boolean" },
        "unavailable_reason": { "type": ["string", "null"], "minLength": 1 },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/warning" }
        },
        "generated_at": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/timestamp" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
