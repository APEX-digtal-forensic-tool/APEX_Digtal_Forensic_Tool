{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apex-forensics.dev/v1/ai-provider-capability.schema.json",
  "title": "APEX AI Provider Capability",
  "$ref": "#/$defs/aiProviderCapability",
  "$defs": {
    "operation": {
      "enum": [
        "RECOMMEND_KEYWORDS",
        "SUMMARIZE_SCOPE",
        "GENERATE_REPORT_DRAFT",
        "EXPLAIN_SELECTION",
        "SUGGEST_NEXT_ANALYSIS",
        "OTHER"
      ]
    },
    "warning": {
      "type": "object",
      "additionalProperties": { "$ref": "common.schema.json#/$defs/restrictedContractJsonValue" },
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "api_key_env": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$",
          "maxLength": 128
        }
      },
      "propertyNames": {
        "anyOf": [
          { "const": "api_key_env" },
          {
            "not": {
              "pattern": "(?:[Aa][Pp][Ii][-_]?[Kk][Ee][Yy]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Rr][Oo][Mm][Pp][Tt]|[Cc][Hh][Aa][Ii][Nn][-_]?[Oo][Ff][-_]?[Tt][Hh][Oo][Uu][Gg][Hh][Tt]|[Rr][Ee][Aa][Ss][Oo][Nn][Ii][Nn][Gg][-_]?[Tt][Rr][Aa][Cc][Ee]|[Rr][Aa][Ww][-_]?[Rr][Ee][Ss][Pp][Oo][Nn][Ss][Ee]|[Rr][Aa][Ww][-_]?[Bb][Oo][Dd][Yy]|^(?:[Rr][Aa][Ww][-_]?[Bb][Ll][Oo][Bb]|[Bb][Ll][Oo][Bb]|[Bb][Ii][Nn][Aa][Rr][Yy]|[Bb][Yy][Tt][Ee][Ss]|[Bb][Aa][Ss][Ee]64|[Aa][Tt][Tt][Aa][Cc][Hh][Mm][Ee][Nn][Tt][-_]?[Bb][Yy][Tt][Ee][Ss])$)"
            }
          }
        ]
      }
    },
    "aiProviderCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "provider_id",
        "provider_version",
        "supported_operations",
        "max_request_items",
        "max_result_items",
        "max_summary_length",
        "is_available",
        "unavailable_reason",
        "warnings",
        "generated_at"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "provider_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "provider_version": { "type": "string", "minLength": 1, "maxLength": 256 },
        "supported_operations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/operation" }
        },
        "max_request_items": { "type": "integer", "minimum": 0 },
        "max_result_items": { "type": "integer", "minimum": 0 },
        "max_summary_length": { "type": "integer", "minimum": 0 },
        "is_available": { "type": "boolean" },
        "unavailable_reason": { "type": ["string", "null"], "minLength": 1 },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/warning" }
        },
        "generated_at": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/timestamp" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
