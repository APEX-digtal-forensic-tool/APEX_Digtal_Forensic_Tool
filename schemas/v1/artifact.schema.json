{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apex-forensics.dev/v1/artifact.schema.json",
  "title": "APEX Artifact",
  "$ref": "#/$defs/artifact",
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_object_id",
        "source_path",
        "source_offset",
        "source_length",
        "analyzer_run_id",
        "analyzer_id",
        "analyzer_version",
        "raw_locator"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "source_object_id": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "analyzer_run_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "analyzer_id": {
          "type": "string",
          "minLength": 1
        },
        "analyzer_version": {
          "type": "string",
          "minLength": 1
        },
        "raw_locator": {
          "oneOf": [
            {
              "$ref": "citation.schema.json#/$defs/rawLocator"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "case_id",
        "artifact_type",
        "schema_version",
        "display_name_key",
        "description_key",
        "title",
        "payload",
        "confidence",
        "created_at",
        "provenance",
        "timestamp_interpretations"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "case_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "artifact_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "display_name_key": {
          "$ref": "common.schema.json#/$defs/resourceKey"
        },
        "description_key": {
          "$ref": "common.schema.json#/$defs/resourceKey"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "timestamp_interpretations": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/timestampInterpretation"
          }
        }
      }
    }
  }
}
