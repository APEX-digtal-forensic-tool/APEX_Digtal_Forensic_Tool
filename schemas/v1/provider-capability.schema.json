{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apex-forensics.dev/v1/provider-capability.schema.json",
  "title": "APEX Provider Capability",
  "$ref": "#/$defs/providerCapability",
  "$defs": {
    "providerCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "provider_version",
        "capability_type",
        "is_available",
        "supported_inputs",
        "supported_outputs",
        "unavailable_reason",
        "warnings",
        "metadata",
        "updated_at"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_version": {
          "type": "string",
          "minLength": 1
        },
        "capability_type": {
          "type": "string",
          "minLength": 1
        },
        "is_available": {
          "type": "boolean"
        },
        "supported_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "supported_outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unavailable_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "updated_at": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
