{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apex-forensics.dev/v1/common.schema.json",
  "title": "APEX Common Types",
  "$defs": {
    "dataClassification": {
      "enum": ["PUBLIC", "INTERNAL", "SENSITIVE", "SECRET"]
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$",
      "default": "ko-KR"
    },
    "timezone": {
      "type": "string",
      "pattern": "^(?:UTC|[A-Za-z_+-]+(?:/[A-Za-z0-9_+.-]+)+)$",
      "default": "Asia/Seoul",
      "description": "IANA Time Zone Database identifier. UTC is accepted as the canonical zero-offset identifier."
    },
    "resourceKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "md5": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "redactedJsonValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/redactedJsonValue" }
        },
        { "$ref": "#/$defs/redactedObject" }
      ]
    },
    "redactedObject": {
      "type": "object",
      "patternProperties": {
        "(?:[Aa][Pp][Ii]_[Kk][Ee][Yy]|[Aa][Pp][Ii][Kk][Ee][Yy]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Cc][Oo][Oo][Kk][Ii][Ee]_[Vv][Aa][Ll][Uu][Ee]|[Kk][Ee][Yy]_[Mm][Aa][Tt][Ee][Rr][Ii][Aa][Ll](?:$|_(?:[Bb]64|[Hh][Ee][Xx]|[Bb][Yy][Tt][Ee][Ss]))|[Kk][Ee][Yy]_[Vv][Aa][Ll][Uu][Ee]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]_[Kk][Ee][Yy]|[Rr][Aa][Ww]_[Kk][Ee][Yy](?:$|_(?:[Bb]64|[Hh][Ee][Xx]|[Bb][Yy][Tt][Ee][Ss]))|[Ss][Ee][Cc][Rr][Ee][Tt]_[Mm][Aa][Tt][Ee][Rr][Ii][Aa][Ll](?:$|_(?:[Bb]64|[Hh][Ee][Xx]|[Bb][Yy][Tt][Ee][Ss]))|[Ss][Ee][Cc][Rr][Ee][Tt]_[Vv][Aa][Ll][Uu][Ee](?:$|_(?:[Bb]64|[Hh][Ee][Xx]|[Bb][Yy][Tt][Ee][Ss]))|[Tt][Oo][Kk][Ee][Nn]|[Nn][Tt]_[Hh][Aa][Ss][Hh]_(?:[Hh][Ee][Xx]|[Bb]64)|[Mm][Aa][Ss][Tt][Ee][Rr][Kk][Ee][Yy]_(?:[Hh][Ee][Xx]|[Bb]64)|[Dd][Bb]_[Kk][Ee][Yy]_(?:[Hh][Ee][Xx]|[Bb]64)|[Dd][Bb]_[Ii][Vv]_(?:[Hh][Ee][Xx]|[Bb]64)|[Pp][Rr][Aa][Gg][Mm][Aa]_[Kk][Ee][Yy](?!_[Hh][Aa][Ss][Hh]$)|(?:[Ss][Ee][Rr][Vv][Ee][Rr]|[Uu][Ss][Ee][Rr])_[Nn][Oo][Nn][Cc][Ee](?!_[Hh][Aa][Ss][Hh]$)|^[Cc][Oo][Oo][Kk][Ii][Ee]$|^[Kk][Ee][Yy]$|^[Pp][Ll][Aa][Ii][Nn][Tt][Ee][Xx][Tt](?:_[Bb]64)?$|^[Ss][Ee][Cc][Rr][Ee][Tt](?:_(?:[Bb]64|[Hh][Ee][Xx]|[Bb][Yy][Tt][Ee][Ss]))?$)": {
          "const": "<redacted>"
        }
      },
      "additionalProperties": { "$ref": "#/$defs/redactedJsonValue" }
    },
    "restrictedContractJsonValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/restrictedContractJsonValue" }
        },
        { "$ref": "#/$defs/restrictedContractObject" }
      ]
    },
    "restrictedContractObject": {
      "type": "object",
      "propertyNames": {
        "not": {
          "pattern": "(?:[Aa][Pp][Ii][-_]?[Kk][Ee][Yy]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Rr][Oo][Mm][Pp][Tt]|[Cc][Hh][Aa][Ii][Nn][-_]?[Oo][Ff][-_]?[Tt][Hh][Oo][Uu][Gg][Hh][Tt]|[Rr][Ee][Aa][Ss][Oo][Nn][Ii][Nn][Gg][-_]?[Tt][Rr][Aa][Cc][Ee]|[Rr][Aa][Ww][-_]?[Rr][Ee][Ss][Pp][Oo][Nn][Ss][Ee]|[Rr][Aa][Ww][-_]?[Bb][Oo][Dd][Yy]|^(?:[Rr][Aa][Ww][-_]?[Bb][Ll][Oo][Bb]|[Bb][Ll][Oo][Bb]|[Bb][Ii][Nn][Aa][Rr][Yy]|[Bb][Yy][Tt][Ee][Ss]|[Bb][Aa][Ss][Ee]64|[Aa][Tt][Tt][Aa][Cc][Hh][Mm][Ee][Nn][Tt][-_]?[Bb][Yy][Tt][Ee][Ss])$)"
        }
      },
      "additionalProperties": { "$ref": "#/$defs/restrictedContractJsonValue" }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message_key",
        "developer_message",
        "retryable",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message_key": {
          "$ref": "#/$defs/resourceKey"
        },
        "developer_message": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message_key",
        "developer_message",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message_key": {
          "$ref": "#/$defs/resourceKey"
        },
        "developer_message": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "details": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "pageInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "next_cursor",
        "has_more",
        "returned"
      ],
      "properties": {
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "has_more": {
          "type": "boolean"
        },
        "returned": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "errors"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "errors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "analysisScope": {
      "enum": [
        "CASE",
        "EVIDENCE",
        "FILESYSTEM",
        "REGISTRY",
        "EVENTLOG",
        "PREFETCH",
        "BROWSER",
        "MEDIA",
        "TIMELINE",
        "KEYWORD_SEARCH",
        "REPORT",
        "CHAIN_OF_CUSTODY"
      ]
    },
    "confidenceLevel": {
      "enum": [
        "CONFIRMED",
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ]
    },
    "partialResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_partial",
        "as_of",
        "completed_scopes",
        "pending_scopes",
        "available_item_count",
        "warning"
      ],
      "properties": {
        "is_partial": {
          "type": "boolean"
        },
        "as_of": {
          "$ref": "#/$defs/timestamp"
        },
        "completed_scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/analysisScope"
          }
        },
        "pending_scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/analysisScope"
          }
        },
        "available_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "warning": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "timestampInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_timestamp",
        "raw_timezone",
        "normalized_utc",
        "display_timestamp",
        "display_timezone",
        "timezone_source",
        "timezone_confidence",
        "dst_status",
        "ambiguity"
      ],
      "properties": {
        "raw_timestamp": {
          "type": "string",
          "minLength": 1
        },
        "raw_timezone": {
          "type": [
            "string",
            "null"
          ]
        },
        "normalized_utc": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_timestamp": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_timezone": {
          "$ref": "#/$defs/timezone"
        },
        "timezone_source": {
          "enum": [
            "CASE_SETTING",
            "EVIDENCE_OS",
            "WINDOWS_REGISTRY",
            "LINUX_LOCALTIME",
            "BROWSER_PROFILE",
            "APPLICATION_SETTING",
            "ARTIFACT_OFFSET",
            "ANALYST_OVERRIDE",
            "UNKNOWN"
          ]
        },
        "timezone_confidence": {
          "$ref": "#/$defs/confidenceLevel"
        },
        "dst_status": {
          "enum": [
            "STANDARD",
            "DAYLIGHT",
            "TRANSITION",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "ambiguity": {
          "enum": [
            "NONE",
            "AMBIGUOUS_LOCAL_TIME",
            "NONEXISTENT_LOCAL_TIME",
            "INVALID_RAW_TIME"
          ]
        }
      }
    }
  }
}
