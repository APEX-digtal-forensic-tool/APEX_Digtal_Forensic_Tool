{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apex-forensics.dev/v1/common.schema.json",
  "title": "APEX Common Types",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "md5": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": ["string", "null"]
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "oneOf": [
            { "$ref": "#/$defs/uuid" },
            { "type": "null" }
          ]
        },
        "details": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "pageInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next_cursor", "has_more", "returned"],
      "properties": {
        "next_cursor": {
          "type": ["string", "null"]
        },
        "has_more": {
          "type": "boolean"
        },
        "returned": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_kind", "source_id"],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/uuid"
        },
        "source_kind": {
          "enum": ["FILE", "ARTIFACT", "TIMELINE", "SEARCH_HIT"]
        },
        "source_id": {
          "$ref": "#/$defs/uuid"
        },
        "source_path": {
          "type": ["string", "null"]
        },
        "source_offset": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "excerpt": {
          "type": ["string", "null"]
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "errors"],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "errors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  }
}
