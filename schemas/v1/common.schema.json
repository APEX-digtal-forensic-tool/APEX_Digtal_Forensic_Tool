{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apex-forensics.dev/v1/common.schema.json",
  "title": "APEX Common Types",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$",
      "default": "ko-KR"
    },
    "timezone": {
      "type": "string",
      "pattern": "^(?:UTC|[A-Za-z_+-]+(?:/[A-Za-z0-9_+.-]+)+)$",
      "default": "Asia/Seoul"
    },
    "resourceKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "md5": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message_key", "developer_message", "retryable", "details"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message_key": {
          "$ref": "#/$defs/resourceKey"
        },
        "developer_message": {
          "type": ["string", "null"]
        },
        "target": {
          "type": ["string", "null"]
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message_key", "developer_message", "details"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message_key": {
          "$ref": "#/$defs/resourceKey"
        },
        "developer_message": {
          "type": ["string", "null"]
        },
        "source_id": {
          "oneOf": [
            { "$ref": "#/$defs/uuid" },
            { "type": "null" }
          ]
        },
        "details": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "pageInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next_cursor", "has_more", "returned"],
      "properties": {
        "next_cursor": {
          "type": ["string", "null"]
        },
        "has_more": {
          "type": "boolean"
        },
        "returned": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "errors"],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "errors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  }
}
