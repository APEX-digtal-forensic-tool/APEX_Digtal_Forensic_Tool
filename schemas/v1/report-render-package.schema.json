{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apex-forensics.dev/v1/report-render-package.schema.json",
  "title": "APEX Report Render Package",
  "$ref": "#/$defs/reportRenderPackage",
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "nullableId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "propertyNames": {
        "not": {
          "pattern": "(?:[Aa][Pp][Ii][-_]?[Kk][Ee][Yy]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Rr][Oo][Mm][Pp][Tt]|[Cc][Hh][Aa][Ii][Nn][-_]?[Oo][Ff][-_]?[Tt][Hh][Oo][Uu][Gg][Hh][Tt]|[Rr][Aa][Ww][-_]?[Rr][Ee][Ss][Pp][Oo][Nn][Ss][Ee]|[Rr][Aa][Ww][-_]?[Bb][Oo][Dd][Yy]|[Bb][Aa][Ss][Ee]64|[Aa][Tt][Tt][Aa][Cc][Hh][Mm][Ee][Nn][Tt][-_]?[Bb][Yy][Tt][Ee][Ss])"
        }
      }
    },
    "reportRenderPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "report_id",
        "report_version_id",
        "case_id",
        "locale",
        "timezone",
        "report_metadata",
        "sections",
        "evidence_manifest",
        "hash_integrity_summary",
        "custody_snapshot_id",
        "context_snapshot_ids",
        "citations",
        "partial_state",
        "stale_state",
        "coverage_summary",
        "limitations",
        "renderer_requirements",
        "package_fingerprint",
        "created_at",
        "package_version"
      ],
      "properties": {
        "package_id": { "$ref": "#/$defs/id" },
        "report_id": { "$ref": "#/$defs/id" },
        "report_version_id": { "$ref": "#/$defs/id" },
        "case_id": { "$ref": "#/$defs/id" },
        "locale": { "$ref": "common.schema.json#/$defs/locale" },
        "timezone": { "$ref": "common.schema.json#/$defs/timezone" },
        "report_metadata": { "$ref": "#/$defs/metadata" },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "report-section.schema.json#/$defs/reportSection" }
        },
        "evidence_manifest": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/metadata" }
        },
        "hash_integrity_summary": { "$ref": "#/$defs/metadata" },
        "custody_snapshot_id": { "$ref": "#/$defs/nullableId" },
        "context_snapshot_ids": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "citations": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "report-section.schema.json#/$defs/citationRef" }
        },
        "partial_state": { "$ref": "#/$defs/metadata" },
        "stale_state": { "$ref": "#/$defs/metadata" },
        "coverage_summary": { "$ref": "#/$defs/metadata" },
        "limitations": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
        },
        "renderer_requirements": { "$ref": "#/$defs/metadata" },
        "package_fingerprint": { "$ref": "common.schema.json#/$defs/sha256" },
        "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "package_version": { "$ref": "common.schema.json#/$defs/schemaVersion" }
      }
    }
  }
}
