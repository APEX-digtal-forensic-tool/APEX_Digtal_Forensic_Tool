{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apex-forensics.dev/v1/timeline-event.schema.json",
  "title": "APEX Phase 4 Timeline",
  "oneOf": [
    {
      "$ref": "#/$defs/timelineEvent"
    },
    {
      "$ref": "#/$defs/timestampNormalization"
    },
    {
      "$ref": "#/$defs/timezoneCandidate"
    },
    {
      "$ref": "#/$defs/timelinePage"
    }
  ],
  "$defs": {
    "timelineSourceType": {
      "enum": [
        "FILE_SYSTEM_NODE",
        "REGISTRY_ARTIFACT",
        "EVENT_LOG_ARTIFACT",
        "PREFETCH_ARTIFACT",
        "MEDIA_ARTIFACT",
        "BROWSER_ARTIFACT",
        "ANALYST_ANNOTATION"
      ]
    },
    "timelineEventType": {
      "enum": [
        "FILE_CREATED",
        "FILE_MODIFIED",
        "FILE_ACCESSED",
        "FILE_METADATA_CHANGED",
        "REGISTRY_KEY_LAST_WRITE",
        "REGISTRY_VALUE_OBSERVED",
        "PROCESS_EXECUTION",
        "LOGON",
        "LOGOFF",
        "PROCESS_CREATED",
        "NETWORK_CONNECTION",
        "FILE_CREATED_BY_PROCESS",
        "REGISTRY_MODIFIED",
        "DNS_QUERY",
        "SERVICE_INSTALLED",
        "EVENT_LOG_CLEARED",
        "PREFETCH_LAST_RUN",
        "MEDIA_CREATED",
        "MEDIA_MODIFIED",
        "MEDIA_CAPTURED",
        "MEDIA_METADATA_TIMESTAMP",
        "MEDIA_CAPTURED_CANDIDATE",
        "BROWSER_PROFILE_OBSERVED",
        "BROWSER_VISIT",
        "BROWSER_SEARCH",
        "BROWSER_DOWNLOAD",
        "BROWSER_DOWNLOAD_STARTED",
        "BROWSER_DOWNLOAD_COMPLETED",
        "BROWSER_DOWNLOAD_OBSERVED",
        "OTHER"
      ]
    },
    "timestampPrecision": {
      "enum": [
        "SECOND",
        "MILLISECOND",
        "MICROSECOND",
        "DAY",
        "UNKNOWN"
      ]
    },
    "timezoneSource": {
      "enum": [
        "EXPLICIT_OFFSET",
        "UTC_SOURCE",
        "CASE_DEFAULT",
        "ARTIFACT_CONFIGURATION",
        "WINDOWS_TIMEZONE_CANDIDATE",
        "ANALYST_CONFIRMED",
        "UNKNOWN"
      ]
    },
    "timezoneConfidence": {
      "enum": [
        "CONFIRMED",
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ]
    },
    "stringOrNull": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestampOrNull": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "flexObject": {
      "type": "object",
      "additionalProperties": true
    },
    "citationArray": {
      "type": "array",
      "items": {
        "$ref": "citation.schema.json#/$defs/citation"
      }
    },
    "warningArray": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/warning"
      }
    },
    "cursorPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "next_cursor",
        "has_more",
        "returned"
      ],
      "properties": {
        "next_cursor": {
          "$ref": "#/$defs/stringOrNull"
        },
        "has_more": {
          "type": "boolean"
        },
        "returned": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "timestampNormalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_timestamp",
        "raw_timezone",
        "timestamp_semantics",
        "normalized_utc",
        "case_timezone",
        "displayed_case_time",
        "timezone_source",
        "timezone_confidence",
        "precision",
        "warnings"
      ],
      "properties": {
        "raw_timestamp": {
          "$ref": "#/$defs/stringOrNull"
        },
        "raw_timezone": {
          "$ref": "#/$defs/stringOrNull"
        },
        "timestamp_semantics": {
          "type": "string",
          "minLength": 1
        },
        "normalized_utc": {
          "$ref": "#/$defs/timestampOrNull"
        },
        "case_timezone": {
          "$ref": "common.schema.json#/$defs/timezone"
        },
        "displayed_case_time": {
          "$ref": "#/$defs/stringOrNull"
        },
        "timezone_source": {
          "$ref": "#/$defs/timezoneSource"
        },
        "timezone_confidence": {
          "$ref": "#/$defs/timezoneConfidence"
        },
        "precision": {
          "$ref": "#/$defs/timestampPrecision"
        },
        "warnings": {
          "$ref": "#/$defs/warningArray"
        }
      }
    },
    "timezoneCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "case_id",
        "evidence_id",
        "timezone",
        "source",
        "confidence",
        "raw_value",
        "citations",
        "created_at"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_id": {
          "$ref": "#/$defs/stringOrNull"
        },
        "timezone": {
          "$ref": "common.schema.json#/$defs/timezone"
        },
        "source": {
          "$ref": "#/$defs/timezoneSource"
        },
        "confidence": {
          "$ref": "#/$defs/timezoneConfidence"
        },
        "raw_value": {
          "$ref": "#/$defs/stringOrNull"
        },
        "citations": {
          "$ref": "#/$defs/citationArray"
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    "timelineEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeline_event_id",
        "case_id",
        "evidence_id",
        "source_type",
        "source_id",
        "source_revision",
        "event_type",
        "event_subtype",
        "title",
        "description",
        "raw_timestamp",
        "raw_timezone",
        "timestamp_semantics",
        "normalized_utc",
        "case_timezone",
        "displayed_case_time",
        "timezone_source",
        "timezone_confidence",
        "precision",
        "analyzer_id",
        "analyzer_version",
        "raw_locator",
        "citations",
        "fields",
        "is_partial",
        "timeline_revision",
        "created_at",
        "dedup_key"
      ],
      "properties": {
        "timeline_event_id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "$ref": "#/$defs/timelineSourceType"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "integer",
          "minimum": 1
        },
        "event_type": {
          "$ref": "#/$defs/timelineEventType"
        },
        "event_subtype": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "raw_timestamp": {
          "$ref": "#/$defs/stringOrNull"
        },
        "raw_timezone": {
          "$ref": "#/$defs/stringOrNull"
        },
        "timestamp_semantics": {
          "type": "string",
          "minLength": 1
        },
        "normalized_utc": {
          "$ref": "#/$defs/timestampOrNull"
        },
        "case_timezone": {
          "$ref": "common.schema.json#/$defs/timezone"
        },
        "displayed_case_time": {
          "$ref": "#/$defs/stringOrNull"
        },
        "timezone_source": {
          "$ref": "#/$defs/timezoneSource"
        },
        "timezone_confidence": {
          "$ref": "#/$defs/timezoneConfidence"
        },
        "precision": {
          "$ref": "#/$defs/timestampPrecision"
        },
        "analyzer_id": {
          "$ref": "#/$defs/stringOrNull"
        },
        "analyzer_version": {
          "$ref": "#/$defs/stringOrNull"
        },
        "raw_locator": {
          "$ref": "#/$defs/flexObject"
        },
        "citations": {
          "$ref": "#/$defs/citationArray"
        },
        "fields": {
          "$ref": "#/$defs/flexObject"
        },
        "is_partial": {
          "type": "boolean"
        },
        "timeline_revision": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "dedup_key": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      }
    },
    "timelinePage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "page",
        "timezone",
        "warnings"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timelineEvent"
          }
        },
        "page": {
          "$ref": "#/$defs/cursorPage"
        },
        "timezone": {
          "$ref": "common.schema.json#/$defs/timezone"
        },
        "warnings": {
          "$ref": "#/$defs/warningArray"
        }
      }
    }
  }
}
