{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apex-forensics.dev/v1/timeline-event.schema.json",
  "title": "APEX Timeline Event",
  "$ref": "#/$defs/timelineEvent",
  "$defs": {
    "timelineEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "case_id",
        "evidence_id",
        "source_kind",
        "source_id",
        "timestamp_utc",
        "timestamp_raw",
        "timezone_offset_minutes",
        "event_type",
        "title",
        "description",
        "actor",
        "path",
        "confidence",
        "metadata"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/uuid" },
        "case_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "evidence_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "source_kind": { "enum": ["FILE", "ARTIFACT"] },
        "source_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "timestamp_utc": { "$ref": "common.schema.json#/$defs/timestamp" },
        "timestamp_raw": { "type": ["string", "null"] },
        "timezone_offset_minutes": {
          "type": ["integer", "null"],
          "minimum": -840,
          "maximum": 840
        },
        "event_type": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "actor": { "type": ["string", "null"] },
        "path": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "metadata": { "$ref": "common.schema.json#/$defs/metadata" }
      }
    }
  }
}
