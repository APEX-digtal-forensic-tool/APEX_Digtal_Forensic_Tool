{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apex-forensics.dev/v1/nss-profile.schema.json",
  "title": "APEX Firefox NSS Profile",
  "$ref": "#/$defs/nssProfile",
  "$defs": {
    "warning": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
      }
    },
    "nssProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "profile_id",
        "case_id",
        "evidence_id",
        "profile_path",
        "key4_db_present",
        "logins_json_present",
        "primary_password_required",
        "schema_status",
        "status",
        "fingerprint",
        "raw_locator",
        "warnings",
        "discovered_at"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "profile_id": { "type": "string", "minLength": 1 },
        "case_id": { "type": "string", "minLength": 1 },
        "evidence_id": { "type": ["string", "null"] },
        "profile_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "key4_db_present": { "type": "boolean" },
        "logins_json_present": { "type": "boolean" },
        "primary_password_required": { "type": ["boolean", "null"] },
        "schema_status": {
          "enum": [
            "SUPPORTED",
            "NSS_PROFILE_INCOMPLETE",
            "NSS_SCHEMA_UNSUPPORTED",
            "UNKNOWN"
          ]
        },
        "status": {
          "enum": [
            "NSS_DECRYPTED",
            "PRIMARY_PASSWORD_REQUIRED",
            "INVALID_PRIMARY_PASSWORD",
            "NSS_PROFILE_INCOMPLETE",
            "NSS_SCHEMA_UNSUPPORTED",
            "NSS_CAPABILITY_UNAVAILABLE",
            "CAPABILITY_UNAVAILABLE"
          ]
        },
        "fingerprint": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/sha256" }, { "type": "null" }]
        },
        "raw_locator": { "type": "object", "additionalProperties": true },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/warning" }
        },
        "discovered_at": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }]
        }
      }
    }
  }
}
