{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apex-forensics.dev/v1/analysis-profile.schema.json",
  "title": "APEX Analysis Profile",
  "$ref": "#/$defs/analysisProfile",
  "$defs": {
    "analyzerOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analyzer_id",
        "enabled",
        "version_constraint",
        "options"
      ],
      "properties": {
        "analyzer_id": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "version_constraint": {
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "$ref": "common.schema.json#/$defs/metadata"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_ids",
        "file_ids",
        "paths",
        "artifact_types",
        "time_from",
        "time_to"
      ],
      "properties": {
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/uuid"
          }
        },
        "file_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/uuid"
          }
        },
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifact_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "time_from": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "time_to": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "analysisProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "case_id",
        "name",
        "profile_type",
        "revision",
        "stages",
        "hashing_mode",
        "analyzers",
        "scope",
        "priority_policy",
        "background_indexing",
        "created_by",
        "created_at",
        "content_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "case_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "profile_type": {
          "enum": [
            "QUICK_TRIAGE",
            "SELECTED_SCOPE",
            "FULL_ANALYSIS",
            "CUSTOM_PROFILE",
            "CUSTOM"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "EVIDENCE_HEADER",
              "PARTITION",
              "FILESYSTEM_METADATA",
              "FILE_HASH",
              "ARTIFACT",
              "INDEX",
              "TIMELINE",
              "MEDIA_METADATA",
              "BROWSER_ARTIFACT"
            ]
          }
        },
        "hashing_mode": {
          "enum": [
            "NONE",
            "ON_DEMAND",
            "FULL"
          ]
        },
        "analyzers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/analyzerOption"
          }
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "priority_policy": {
          "enum": [
            "USER_SELECTED_FIRST",
            "BALANCED",
            "BACKGROUND_ONLY"
          ]
        },
        "background_indexing": {
          "type": "boolean"
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "content_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    }
  }
}
